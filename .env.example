# Copy to .env and fill in. .env is git-ignored: never commit the API key.
# Key: https://create.roblox.com/dashboard/credentials (permission: universe-places:write)
ROBLOX_API_KEY=
# Both IDs come from the experience's URL / Studio: Game Settings shows them,
# or the place URL is roblox.com/games/<placeId>/...
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=
